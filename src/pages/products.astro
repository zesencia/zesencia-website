---
import Layout from "../layouts/Layout.astro";
import { azkarAppStoreUrl } from "../data/apps";

const icon = (path: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;

const appStoreUrl = azkarAppStoreUrl;

const azkarFeatures = [
  "Ready-made library of daily, morning & evening, weekly and monthly adhkar, plus Tasbeeh Fatima and duas",
  "Reminders at a set time or linked to prayer times, calculated offline",
  "Streaks, a 14-day chart and achievements to keep your practice consistent",
  "iCloud sync across iPhone and iPad, and a home-screen widget",
  "Private by design — no accounts, no tracking, nothing collected",
];

const upcoming = [
  {
    icon: icon(
      '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>'
    ),
    title: "Productivity Apps",
    status: "In Planning",
    description:
      "A future family of focused productivity tools that help you organize, plan, and accomplish more—without the clutter.",
  },
  {
    icon: icon(
      '<path d="M12 2a7 7 0 0 0-4 12.7V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.3A7 7 0 0 0 12 2Z"/><path d="M9 21h6"/>'
    ),
    title: "AI Tools",
    status: "In Planning",
    description:
      "Practical AI-powered tools that make everyday tasks smarter and simpler—useful intelligence, not novelty.",
  },
];
---

<Layout
  title="Products"
  description="Azkar Tracker, our first app, is available now on the App Store for iPhone and iPad—with focused productivity apps and practical AI tools to follow."
  ogImage="/azkar-tracker-og.jpg"
>
  <section class="section products-intro">
    <div class="container text-center" data-animate>
      <span class="eyebrow">Products</span>
      <h1>Our first app is live on the App Store</h1>
      <p class="products-intro__body">
        We build software with the same care we'd want in the apps we use every day. Azkar Tracker
        is available now, with more on the way.
      </p>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <article class="card featured" data-animate>
        <a href={appStoreUrl} class="featured__banner" target="_blank" rel="noopener">
          <img
            src="/azkar-tracker-banner.jpg"
            alt="Azkar Tracker: Zikr & Tasbih — Download on the App Store"
            width="1280"
            height="720"
            loading="eager"
          />
        </a>
        <div class="featured__body">
          <div class="product__heading">
            <h2>Azkar Tracker</h2>
            <span class="product__status product__status--live">Available Now</span>
          </div>
          <p class="featured__tagline">Zikr &amp; Tasbih counter for iPhone and iPad</p>
          <p>
            A beautifully simple app for daily remembrance. Count your tasbih, keep up with your
            morning and evening adhkar, and build a consistent practice—with reminders tied to
            prayer times and streaks that keep you going.
          </p>
          <ul class="featured__list">
            {azkarFeatures.map((feature) => <li>{feature}</li>)}
          </ul>
          <div class="featured__actions">
            <a href={appStoreUrl} class="btn btn--primary" target="_blank" rel="noopener">
              Download on the App Store
            </a>
            <a href="/azkar-tracker/privacy" class="btn btn--secondary">Privacy Policy</a>
          </div>
          <p class="featured__meta">Free · Requires iOS 17 or later</p>
        </div>
      </article>

      <h2 class="upcoming__title text-center" data-animate>What's next</h2>
      <div class="grid grid--2 products-grid" data-animate-group>
        {upcoming.map((product) => (
          <div class="card product">
            <div class="card-icon" set:html={product.icon} />
            <div class="product__heading">
              <h3>{product.title}</h3>
              <span class="product__status">{product.status}</span>
            </div>
            <p>{product.description}</p>
          </div>
        ))}
      </div>
      <div class="text-center products-cta" data-animate>
        <p>Want to hear when our next app launches?</p>
        <a href="/contact" class="btn btn--primary">Get in Touch</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .products-intro {
    padding-block: 96px 64px;
  }

  .products-intro h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    max-width: 720px;
    margin: 0 auto 16px;
  }

  .products-intro__body {
    max-width: 560px;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .featured__banner {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
    transition: transform 0.2s ease;
  }

  .featured__banner:hover {
    transform: translateY(-2px);
  }

  .featured__banner img {
    display: block;
    width: 100%;
    height: auto;
  }

  .featured__body {
    min-width: 0;
  }

  .featured__tagline {
    margin: 0 0 16px;
    font-weight: 600;
    color: var(--color-heading);
  }

  .featured__list {
    margin: 20px 0 28px;
    padding-left: 20px;
    color: var(--color-text-secondary);
  }

  .featured__list li {
    margin-bottom: 8px;
  }

  .featured__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .featured__meta {
    margin: 16px 0 0;
    font-size: 0.9rem;
  }

  .upcoming__title {
    margin: 72px 0 32px;
    font-size: 1.5rem;
  }

  .product__heading {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .product__heading h2,
  .product__heading h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .featured .product__heading h2 {
    font-size: 1.75rem;
  }

  .product__status {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    background: var(--color-accent-tint);
    border: 1px solid var(--color-accent-tint-strong);
    border-radius: var(--radius-full);
    padding: 3px 10px;
    white-space: nowrap;
  }

  .product__status--live {
    color: #047857;
    background: #ecfdf5;
    border-color: #a7f3d0;
  }

  .products-cta {
    margin-top: 56px;
  }

  .products-cta p {
    margin: 0 0 20px;
    font-size: 1.05rem;
  }

  @media (max-width: 860px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
